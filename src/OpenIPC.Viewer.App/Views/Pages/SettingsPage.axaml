<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenIPC.Viewer.App.ViewModels"
             xmlns:svc="using:OpenIPC.Viewer.App.Services"
             xmlns:conv="using:OpenIPC.Viewer.App.Converters"
             xmlns:controls="using:OpenIPC.Viewer.App.Controls"
             xmlns:b="using:OpenIPC.Viewer.App.Behaviors"
             x:Class="OpenIPC.Viewer.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

  <UserControl.Styles>
    <!-- Section card kept for any future "feature card" — fields below use
         the bare Grid + label layout, no card wrapper, so detail looks like
         macOS Settings (flat with section header). -->
    <Style Selector="Path.section-icon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Button.outlined">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <!-- Sidebar / list ListBox: flat tiles, accent on selection. -->
    <Style Selector="ListBox.sections">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.sections ListBoxItem">
      <Setter Property="Padding" Value="10,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Per-item Lucide icon stroke colour mirrors the row's foreground so it
         flips to white on the selected/accent state automatically. -->
    <Style Selector="ListBox.sections Path.tile-icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.sections ListBoxItem:selected Path.tile-icon">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="ListBox.sections Path.tile-chevron">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stroke" Value="{StaticResource TextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Notifications section: value pickers give way on phone widths
         (b:Adaptive.CompactBelow on the section toggles .compact). -->
    <Style Selector="ComboBox.field">
      <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="ComboBox.field-wide">
      <Setter Property="MinWidth" Value="240" />
    </Style>
    <Style Selector="StackPanel.compact ComboBox.field">
      <Setter Property="MinWidth" Value="110" />
    </Style>
    <Style Selector="StackPanel.compact ComboBox.field-wide">
      <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="Button.back-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>

    <!-- ===== Master / list pane (column 0) ===== -->
    <ScrollViewer Grid.Column="0"
                  IsVisible="{Binding ShowList}"
                  HorizontalScrollBarVisibility="Disabled">
      <!-- ALL inset lives on the content, never on ScrollViewer.Padding: the
           padding is deducted from the viewport but never added to the extent,
           so the content kept its full width and hung off the right edge, and
           the last row could not be scrolled clear of the bottom. -->
      <StackPanel Spacing="12" Margin="0,0,8,24">
        <TextBlock Text="{Binding [Settings.Title], Source={x:Static svc:Localizer.Instance}}"
                   FontSize="{StaticResource FontSizeXl}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,4" />

        <ListBox Classes="sections"
                 SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconAppearance}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.Appearance], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconVideo}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.Video], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconRecord}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.Recording], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconRadar}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.Discovery], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconTerminal}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.Ssh], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconAdvanced}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.Advanced], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconBell}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.Notifications.Section], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="lucide tile-icon"
                    Data="{StaticResource IconAbout}"
                    Margin="0,0,12,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding [Settings.About], Source={x:Static svc:Localizer.Instance}}"
                         VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="lucide tile-chevron"
                    Data="{StaticResource IconChevronRight}"
                    IsVisible="{Binding !IsWide}" />
            </Grid>
          </ListBoxItem>
        </ListBox>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Detail pane (column 1) ===== -->
    <ScrollViewer Grid.Column="1"
                  IsVisible="{Binding ShowDetail}"
                  HorizontalScrollBarVisibility="Disabled">
      <!-- See the master pane above: every inset goes on the content, or combo
           boxes and wrapped paragraphs run past the right edge on a phone. -->
      <StackPanel Spacing="20" Margin="16,0,8,24">

        <!-- Back link — narrow only -->
        <Button Classes="back-link"
                IsVisible="{Binding ShowBackButton}"
                Command="{Binding BackToListCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="lucide" Data="{StaticResource IconChevronLeft}"
                  Stroke="{StaticResource TextSecondaryBrush}"
                  Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding [Settings.Title], Source={x:Static svc:Localizer.Instance}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Appearance -->
        <StackPanel IsVisible="{Binding IsAppearance}" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconAppearance}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Appearance], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Appearance.Language], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding Language, Mode=TwoWay}"
                      MinWidth="140">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageCodeConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Appearance.StartPage], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding StartPageOptions}"
                      SelectedItem="{Binding StartPage, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Display}"
                      MinWidth="140" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsStartupLayoutVisible}">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Appearance.StartupLayout], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding StartupLayoutOptions}"
                      SelectedItem="{Binding StartupLayout, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Display}"
                      MinWidth="140" />
          </Grid>

          <CheckBox IsChecked="{Binding ShowSplash}"
                    Content="{Binding [Settings.Appearance.ShowSplash], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <!-- Desktop only: mobile has no tray. -->
          <CheckBox IsChecked="{Binding CloseToTray}"
                    IsVisible="{Binding IsDesktopPlatform}"
                    Content="{Binding [Settings.Appearance.CloseToTray], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- Video -->
        <StackPanel IsVisible="{Binding IsVideo}" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconVideo}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Video], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <CheckBox IsChecked="{Binding ShowTelemetryOverlay}"
                    Content="{Binding [Settings.Video.TelemetryOverlay], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <CheckBox IsChecked="{Binding AutoSdHd}"
                    Content="{Binding [Settings.Video.AutoSdHd], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <CheckBox IsChecked="{Binding AiForceCpu}"
                    Content="{Binding [Settings.Video.AiForceCpu], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Video.MaxGridSessions], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding GridSessionOptions}"
                      SelectedItem="{Binding MaxConcurrentGridSessions, Mode=TwoWay}"
                      MinWidth="80" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Video.RtspTransport], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TransportOptions}"
                      SelectedItem="{Binding RtspTransport, Mode=TwoWay}"
                      MinWidth="80" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Video.NetworkInterface], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding NetworkInterfaceOptions}"
                      SelectedItem="{Binding SelectedNetworkInterface, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Display}"
                      MinWidth="160" />
          </Grid>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="field-label"
                         Text="{Binding [Settings.Video.IdleTimeout], Source={x:Static svc:Localizer.Instance}}" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding IdleTimeoutOptions}"
                        SelectedItem="{Binding IdleTimeout, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Display}"
                        MinWidth="120" />
            </Grid>
            <TextBlock Classes="field-label"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       Text="{Binding [Settings.Video.IdleTimeout.Note], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
        </StackPanel>

        <!-- Recording -->
        <StackPanel IsVisible="{Binding IsRecording}" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconRecord}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Recording], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="field-label"
                       Text="{Binding [Settings.Recording.Directory], Source={x:Static svc:Localizer.Instance}}" />
            <TextBox Text="{Binding EffectiveRecordingsDirectory, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="{StaticResource FontMono}"
                     FontSize="{StaticResource FontSizeSm}"
                     Background="{StaticResource Bg0Brush}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     BorderBrush="{StaticResource BorderWeakBrush}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" Margin="0,2,0,0">
              <Button Classes="outlined"
                      Content="{Binding [Settings.Recording.PickFolder], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding PickRecordingsDirectoryCommand}" />
              <Button Classes="outlined"
                      Content="{Binding [Settings.Recording.Reset], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding ResetRecordingsDirectoryCommand}"
                      IsVisible="{Binding IsRecordingsDirOverridden}"
                      Foreground="{StaticResource TextSecondaryBrush}" />
              <Button Classes="outlined"
                      Content="{Binding [Settings.Recording.Open], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding OpenRecordingsDirectoryCommand}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>

        <!-- Discovery -->
        <StackPanel IsVisible="{Binding IsDiscovery}" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconRadar}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Discovery], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <CheckBox IsChecked="{Binding AutoScanLanOnStartup}"
                    Content="{Binding [Settings.Discovery.AutoScan], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- SSH (Phase 13) -->
        <StackPanel IsVisible="{Binding IsSsh}" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconTerminal}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Ssh], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <CheckBox IsChecked="{Binding SshStrictHostKey}"
                    Content="{Binding [Settings.Ssh.StrictHostKey], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Ssh.DefaultPort], Source={x:Static svc:Localizer.Instance}}" />
            <NumericUpDown Grid.Column="1" Value="{Binding SshDefaultPort, Mode=TwoWay}"
                           Minimum="1" Maximum="65535" Increment="1" FormatString="0" MinWidth="120" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Ssh.TerminalFontSize], Source={x:Static svc:Localizer.Instance}}" />
            <NumericUpDown Grid.Column="1" Value="{Binding SshTerminalFontSize, Mode=TwoWay}"
                           Minimum="8" Maximum="32" Increment="1" FormatString="0" MinWidth="120" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Ssh.Theme], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TerminalThemeOptions}"
                      SelectedItem="{Binding SshTerminalTheme, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Display}"
                      MinWidth="160" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Ssh.CursorStyle], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TerminalCursorStyleOptions}"
                      SelectedItem="{Binding SshTerminalCursorStyle, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Display}"
                      MinWidth="160" />
          </Grid>

          <CheckBox IsChecked="{Binding SshTerminalCursorBlink}"
                    Content="{Binding [Settings.Ssh.CursorBlink], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Ssh.Scrollback], Source={x:Static svc:Localizer.Instance}}" />
            <NumericUpDown Grid.Column="1" Value="{Binding SshTerminalScrollback, Mode=TwoWay}"
                           Minimum="100" Maximum="50000"
                           Increment="500" FormatString="0" MinWidth="120" />
          </Grid>

          <!-- Live preview: the real terminal control over a fixed sample screen. -->
          <Border HorizontalAlignment="Left"
                  CornerRadius="{StaticResource RadiusSm}"
                  BorderBrush="{StaticResource BorderWeakBrush}" BorderThickness="1"
                  ClipToBounds="True">
            <controls:TerminalView Emulator="{Binding TerminalPreview}"
                                   ColorTheme="{Binding SshTerminalTheme.Theme}"
                                   CursorStyle="{Binding SshTerminalCursorStyle.Style}"
                                   CursorBlink="{Binding SshTerminalCursorBlink}"
                                   TerminalFontSize="{Binding SshTerminalPreviewFontSize}"
                                   FitToEmulator="True"
                                   Focusable="False"
                                   IsHitTestVisible="False" />
          </Border>

          <StackPanel Spacing="6">
            <TextBlock Classes="field-label"
                       Text="{Binding [Settings.Ssh.MajesticPath], Source={x:Static svc:Localizer.Instance}}" />
            <TextBox Text="{Binding MajesticConfigPath, Mode=TwoWay}"
                     FontFamily="{StaticResource FontMono}"
                     FontSize="{StaticResource FontSizeSm}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <Button Classes="outlined"
                    Content="{Binding [Settings.Ssh.ResetHostKeys], Source={x:Static svc:Localizer.Instance}}"
                    Command="{Binding ResetHostKeysCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding [Settings.Ssh.HostKeysCleared], Source={x:Static svc:Localizer.Instance}}"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       IsVisible="{Binding HostKeysJustCleared}" />
          </StackPanel>
        </StackPanel>

        <!-- Advanced -->
        <StackPanel IsVisible="{Binding IsAdvanced}" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconAdvanced}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Advanced], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <CheckBox IsChecked="{Binding VerboseLogging}"
                    Content="{Binding [Settings.Advanced.VerboseLogging], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <CheckBox IsChecked="{Binding RawConfigEditorEnabled}"
                    Content="{Binding [Settings.Advanced.RawConfigEditor], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <CheckBox IsChecked="{Binding SingleInstance}"
                    IsVisible="{Binding IsDesktopPlatform}"
                    Content="{Binding [Settings.Advanced.SingleInstance], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <StackPanel Spacing="6">
            <Button Classes="outlined"
                    Content="{Binding [Settings.Advanced.OpenAppData], Source={x:Static svc:Localizer.Instance}}"
                    Command="{Binding OpenAppDataDirectoryCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding AppDataDirectory}"
                       FontFamily="{StaticResource FontMono}"
                       FontSize="{StaticResource FontSizeSm}"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <!-- Config export / import (Phase 19.2) -->
          <Border Background="{StaticResource BorderWeakBrush}" Height="1" Margin="0,8" />
          <TextBlock Classes="section-title"
                     Text="{Binding [Settings.Backup.Section], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding [Settings.Backup.Description], Source={x:Static svc:Localizer.Instance}}" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Classes="outlined"
                    Content="{Binding [Settings.Backup.Export], Source={x:Static svc:Localizer.Instance}}"
                    Command="{Binding ExportConfigCommand}" />
            <Button Classes="outlined"
                    Content="{Binding [Settings.Backup.Import], Source={x:Static svc:Localizer.Instance}}"
                    Command="{Binding ImportConfigCommand}" />
          </WrapPanel>
          <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="{StaticResource FontSizeSm}"
                     Text="{Binding BackupStatus}"
                     IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- Network config auto-sync (Phase 20) -->
          <Border Background="{StaticResource BorderWeakBrush}" Height="1" Margin="0,8" />
          <TextBlock Classes="section-title"
                     Text="{Binding [Settings.ConfigSync.Section], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding [Settings.ConfigSync.Description], Source={x:Static svc:Localizer.Instance}}" />
          <CheckBox IsChecked="{Binding ConfigSyncEnabled}"
                    Content="{Binding [Settings.ConfigSync.Enable], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />
          <StackPanel Spacing="6" IsEnabled="{Binding ConfigSyncEnabled}">
            <TextBlock Classes="field-label"
                       Text="{Binding [Settings.ConfigSync.PathLabel], Source={x:Static svc:Localizer.Instance}}" />
            <TextBox Text="{Binding ConfigSyncPath, Mode=TwoWay}"
                     PlaceholderText="{Binding [Settings.ConfigSync.PathPlaceholder], Source={x:Static svc:Localizer.Instance}}"
                     FontFamily="{StaticResource FontMono}"
                     FontSize="{StaticResource FontSizeSm}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding ConfigSyncIncludeCredentials}"
                    IsEnabled="{Binding ConfigSyncEnabled}"
                    Content="{Binding [Settings.ConfigSync.IncludeCreds], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />
          <StackPanel Spacing="6" IsVisible="{Binding ConfigSyncIncludeCredentials}"
                      IsEnabled="{Binding ConfigSyncEnabled}">
            <TextBlock Classes="field-label"
                       Text="{Binding [Settings.ConfigSync.Passphrase], Source={x:Static svc:Localizer.Instance}}" />
            <TextBox Text="{Binding ConfigSyncPassphrase, Mode=TwoWay}"
                     PasswordChar="•"
                     FontFamily="{StaticResource FontMono}"
                     FontSize="{StaticResource FontSizeSm}" />
            <TextBlock Foreground="{StaticResource TextTertiaryBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       TextWrapping="Wrap"
                       Text="{Binding [Settings.ConfigSync.PassphraseHint], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
          <TextBlock Foreground="{StaticResource WarningBrush}"
                     FontSize="{StaticResource FontSizeSm}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ConfigSyncEnabled}"
                     Text="{Binding [Settings.ConfigSync.MirrorWarning], Source={x:Static svc:Localizer.Instance}}" />
          <Button Classes="outlined"
                  IsEnabled="{Binding ConfigSyncEnabled}"
                  Content="{Binding [Settings.ConfigSync.SyncNow], Source={x:Static svc:Localizer.Instance}}"
                  Command="{Binding SyncConfigNowCommand}" />
          <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="{StaticResource FontSizeSm}"
                     TextWrapping="Wrap"
                     Text="{Binding ConfigSyncStatusText}"
                     IsVisible="{Binding ConfigSyncStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        </StackPanel>

        <!-- Notifications (Phase 19.3): what fires, how it looks/sounds, external actions.
             Visibility binds on the page VM; the inner panel switches to the
             section's own VM (DataContext set on a middle element so its binding
             still resolves against the page VM). -->
        <Panel IsVisible="{Binding IsNotifications}">
        <Panel DataContext="{Binding Notifications}">
        <StackPanel Spacing="16" x:DataType="vm:NotificationSettingsViewModel"
                    b:Adaptive.CompactBelow="560">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconBell}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Notifications.Section], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <CheckBox IsChecked="{Binding NotificationsEnabled}"
                    Content="{Binding [Settings.Notifications.Enable], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <!-- Event types (apply to notifications and external actions) -->
          <TextBlock Classes="field-label"
                     Text="{Binding [Settings.Notify.Types], Source={x:Static svc:Localizer.Instance}}" />
          <CheckBox IsChecked="{Binding NotifyOnMotion}"
                    Content="{Binding [Settings.Notifications.Motion], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />
          <CheckBox IsChecked="{Binding NotifyOnDetection}"
                    Content="{Binding [Settings.Notifications.Detection], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <!-- Thresholds -->
          <Border Background="{StaticResource BorderWeakBrush}" Height="1" Margin="0,4" />
          <TextBlock Classes="section-title"
                     Text="{Binding [Settings.Notify.Thresholds], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                     Text="{Binding [Settings.Notify.Thresholds.Note], Source={x:Static svc:Localizer.Instance}}" />
          <StackPanel Spacing="4">
            <TextBlock Classes="field-label"
                       Text="{Binding [Settings.Notify.Confidence], Source={x:Static svc:Localizer.Instance}}" />
            <Grid ColumnDefinitions="*,Auto">
              <Slider Grid.Column="0" MaxWidth="360" Minimum="0" Maximum="95"
                      TickFrequency="5" IsSnapToTickEnabled="True"
                      Value="{Binding MinConfidencePercent, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" MinWidth="64" Margin="12,0,0,0" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="{Binding MinConfidenceText}" />
            </Grid>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Notify.Duration], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1" Classes="field"
                      ItemsSource="{Binding DurationOptions}"
                      SelectedItem="{Binding MinDuration, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Display}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Notify.Objects], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1" Classes="field"
                      ItemsSource="{Binding ObjectOptions}"
                      SelectedItem="{Binding MinObjects, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Display}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="field-label"
                       Text="{Binding [Settings.Notifications.Cooldown], Source={x:Static svc:Localizer.Instance}}" />
            <ComboBox Grid.Column="1" Classes="field"
                      ItemsSource="{Binding CooldownOptions}"
                      SelectedItem="{Binding NotificationCooldownSeconds}" />
          </Grid>
          <CheckBox IsChecked="{Binding QuietHoursEnabled}"
                    Content="{Binding [Settings.Notifications.QuietHours], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsEnabled="{Binding QuietHoursEnabled}">
            <TextBlock Text="{Binding [Settings.Notifications.From], Source={x:Static svc:Localizer.Instance}}"
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding QuietHoursStartHour}" Width="80" />
            <TextBlock Text="{Binding [Settings.Notifications.To], Source={x:Static svc:Localizer.Instance}}"
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding QuietHoursEndHour}" Width="80" />
          </StackPanel>

          <!-- Style: app toast + own sound, or native Windows toast -->
          <StackPanel Spacing="12" IsVisible="{Binding IsDesktop}">
            <Border Background="{StaticResource BorderWeakBrush}" Height="1" Margin="0,4" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.Notify.Style], Source={x:Static svc:Localizer.Instance}}" />
            <StackPanel Spacing="6" IsVisible="{Binding IsSystemStyleSupported}">
              <RadioButton GroupName="NotifyStyle"
                           IsChecked="{Binding UseAppStyle, Mode=TwoWay}"
                           Content="{Binding [Settings.Notify.Style.App], Source={x:Static svc:Localizer.Instance}}"
                           Foreground="{StaticResource TextPrimaryBrush}" />
              <RadioButton GroupName="NotifyStyle"
                           IsChecked="{Binding UseSystemStyle, Mode=TwoWay}"
                           Content="{Binding [Settings.Notify.Style.Windows], Source={x:Static svc:Localizer.Instance}}"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <!-- Windows style: everything else is configured in Windows Settings -->
            <StackPanel Spacing="8" IsVisible="{Binding UseSystemStyle}">
              <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                         Text="{Binding [Settings.Notify.Style.Windows.Note], Source={x:Static svc:Localizer.Instance}}" />
              <TextBlock Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                         FontSize="{StaticResource FontSizeSm}"
                         Text="{Binding SystemStatus}"
                         IsVisible="{Binding SystemStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button Classes="outlined" HorizontalAlignment="Left"
                      Content="{Binding [Settings.Notify.Style.OpenWindows], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding OpenSystemSettingsCommand}" />
            </StackPanel>

            <!-- App style: own sound -->
            <StackPanel Spacing="10" IsVisible="{Binding ShowSoundSettings}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="field-label"
                           Text="{Binding [Settings.Notify.Sound], Source={x:Static svc:Localizer.Instance}}" />
                <ComboBox Grid.Column="1" Classes="field"
                          ItemsSource="{Binding SoundModeOptions}"
                          SelectedItem="{Binding SoundMode, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Display}" />
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Classes="field-label"
                           Text="{Binding [Settings.Notify.Volume], Source={x:Static svc:Localizer.Instance}}" />
                <Grid ColumnDefinitions="*,Auto">
                  <Slider Grid.Column="0" MaxWidth="360" Minimum="0" Maximum="100"
                          TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Volume, Mode=TwoWay}" />
                  <TextBlock Grid.Column="1" MinWidth="56" Margin="12,0,0,0" VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Text="{Binding VolumeText}" />
                </Grid>
              </StackPanel>
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <Button Classes="outlined"
                        Content="{Binding [Settings.Notify.Sound.Pick], Source={x:Static svc:Localizer.Instance}}"
                        Command="{Binding PickSoundCommand}" />
                <Button Classes="outlined"
                        Content="{Binding [Settings.Notify.Sound.Preview], Source={x:Static svc:Localizer.Instance}}"
                        Command="{Binding PreviewSoundCommand}" />
              </WrapPanel>
              <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         TextWrapping="Wrap" IsVisible="{Binding IsCustomSound}"
                         Text="{Binding CustomSoundName}" />
              <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         TextWrapping="Wrap"
                         Text="{Binding [Settings.Notify.Sound.Hint], Source={x:Static svc:Localizer.Instance}}" />
              <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="{StaticResource FontSizeSm}"
                         TextWrapping="Wrap" Text="{Binding SoundStatus}"
                         IsVisible="{Binding SoundStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>

          <Button Classes="outlined"
                  Content="{Binding [Settings.Notifications.Test], Source={x:Static svc:Localizer.Instance}}"
                  Command="{Binding TestNotificationCommand}"
                  HorizontalAlignment="Left" />
          <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="{StaticResource FontSizeSm}"
                     TextWrapping="Wrap" Text="{Binding TestStatus}"
                     IsVisible="{Binding TestStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- External actions -->
          <Border Background="{StaticResource BorderWeakBrush}" Height="1" Margin="0,8" />
          <TextBlock Classes="section-title"
                     Text="{Binding [Settings.Actions], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                     Text="{Binding [Settings.Actions.Description], Source={x:Static svc:Localizer.Instance}}" />
          <CheckBox IsChecked="{Binding ActionsEnabled}"
                    Content="{Binding [Settings.Actions.Enable], Source={x:Static svc:Localizer.Instance}}"
                    Foreground="{StaticResource TextPrimaryBrush}" />

          <StackPanel Spacing="14" IsEnabled="{Binding ActionsEnabled}">
            <TextBlock Classes="field-label"
                       Text="{Binding [Settings.Actions.Types], Source={x:Static svc:Localizer.Instance}}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="4">
              <CheckBox IsChecked="{Binding ActionsOnMotion}"
                        Content="{Binding [Settings.Notifications.Motion], Source={x:Static svc:Localizer.Instance}}"
                        Foreground="{StaticResource TextPrimaryBrush}" />
              <CheckBox IsChecked="{Binding ActionsOnDetection}"
                        Content="{Binding [Settings.Notifications.Detection], Source={x:Static svc:Localizer.Instance}}"
                        Foreground="{StaticResource TextPrimaryBrush}" />
            </WrapPanel>
            <CheckBox IsChecked="{Binding ActionsIgnoreQuietHours}"
                      Content="{Binding [Settings.Actions.IgnoreQuiet], Source={x:Static svc:Localizer.Instance}}"
                      Foreground="{StaticResource TextPrimaryBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="field-label"
                         Text="{Binding [Settings.Actions.Cooldown], Source={x:Static svc:Localizer.Instance}}" />
              <ComboBox Grid.Column="1" Classes="field"
                        ItemsSource="{Binding ActionCooldownOptions}"
                        SelectedItem="{Binding ActionsCooldown, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Display}" />
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         TextWrapping="Wrap"
                         Text="{Binding [Settings.Actions.Placeholders], Source={x:Static svc:Localizer.Instance}}" />
              <SelectableTextBlock FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding PlaceholdersHint}" />
            </StackPanel>

            <!-- TCP/UDP signal -->
            <Border Background="{StaticResource BorderWeakBrush}" Height="1" />
            <CheckBox IsChecked="{Binding SignalEnabled}" FontWeight="SemiBold"
                      Content="{Binding [Settings.Actions.Signal], Source={x:Static svc:Localizer.Instance}}"
                      Foreground="{StaticResource TextPrimaryBrush}" />
            <StackPanel Spacing="8" IsEnabled="{Binding SignalEnabled}">
              <Grid ColumnDefinitions="Auto,*,Auto" >
                <ComboBox Grid.Column="0" Width="90"
                          ItemsSource="{Binding SignalProtocolOptions}"
                          SelectedItem="{Binding SignalProtocol, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Display}" />
                <TextBox Grid.Column="1" Margin="8,0"
                         Text="{Binding SignalHost, Mode=TwoWay}"
                         PlaceholderText="{Binding [Settings.Actions.Signal.Host], Source={x:Static svc:Localizer.Instance}}" />
                <NumericUpDown Grid.Column="2" Value="{Binding SignalPort, Mode=TwoWay}"
                               Minimum="1" Maximum="65535" Increment="1" FormatString="0" MinWidth="120" />
              </Grid>
              <TextBox Text="{Binding SignalPayload, Mode=TwoWay}"
                       FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSm}"
                       PlaceholderText="{Binding [Settings.Actions.Signal.Payload], Source={x:Static svc:Localizer.Instance}}" />
              <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         TextWrapping="Wrap"
                         Text="{Binding [Settings.Actions.Signal.Hint], Source={x:Static svc:Localizer.Instance}}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <Button Classes="outlined" HorizontalAlignment="Left"
                      Content="{Binding [Settings.Actions.Test], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding TestSignalCommand}" />
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         Text="{Binding SignalStatus}"
                         IsVisible="{Binding SignalStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- HTTP webhook -->
            <Border Background="{StaticResource BorderWeakBrush}" Height="1" />
            <CheckBox IsChecked="{Binding HttpEnabled}" FontWeight="SemiBold"
                      Content="{Binding [Settings.Actions.Http], Source={x:Static svc:Localizer.Instance}}"
                      Foreground="{StaticResource TextPrimaryBrush}" />
            <StackPanel Spacing="8" IsEnabled="{Binding HttpEnabled}">
              <Grid ColumnDefinitions="Auto,*">
                <ComboBox Grid.Column="0" Width="90"
                          ItemsSource="{Binding HttpMethodOptions}"
                          SelectedItem="{Binding HttpMethod, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Margin="8,0,0,0"
                         Text="{Binding HttpUrl, Mode=TwoWay}"
                         FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSm}"
                         PlaceholderText="https://example.com/hook?camera={camera}" />
              </Grid>
              <TextBox Text="{Binding HttpBody, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                       FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSm}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <Button Classes="outlined" HorizontalAlignment="Left"
                      Content="{Binding [Settings.Actions.Test], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding TestHttpCommand}" />
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         Text="{Binding HttpStatus}"
                         IsVisible="{Binding HttpStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- E-mail -->
            <Border Background="{StaticResource BorderWeakBrush}" Height="1" />
            <CheckBox IsChecked="{Binding EmailEnabled}" FontWeight="SemiBold"
                      Content="{Binding [Settings.Actions.Email], Source={x:Static svc:Localizer.Instance}}"
                      Foreground="{StaticResource TextPrimaryBrush}" />
            <StackPanel Spacing="8" IsEnabled="{Binding EmailEnabled}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="field-label"
                           Text="{Binding [Settings.Actions.Email.Transport], Source={x:Static svc:Localizer.Instance}}" />
                <ComboBox Grid.Column="1" Classes="field-wide"
                          ItemsSource="{Binding EmailTransportOptions}"
                          SelectedItem="{Binding EmailTransport, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Display}" />
              </Grid>
              <TextBox Text="{Binding EmailTo, Mode=TwoWay}"
                       PlaceholderText="{Binding [Settings.Actions.Email.To], Source={x:Static svc:Localizer.Instance}}" />
              <TextBox Text="{Binding EmailSubject, Mode=TwoWay}"
                       PlaceholderText="{Binding [Settings.Actions.Email.Subject], Source={x:Static svc:Localizer.Instance}}" />
              <TextBox Text="{Binding EmailBody, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />

              <!-- SMTP server; login/password live in the OS credential store -->
              <StackPanel Spacing="8" IsVisible="{Binding IsSmtp}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding SmtpHost, Mode=TwoWay}"
                           PlaceholderText="{Binding [Settings.Actions.Smtp.Host], Source={x:Static svc:Localizer.Instance}}" />
                  <NumericUpDown Grid.Column="1" Margin="8,0,0,0" Value="{Binding SmtpPort, Mode=TwoWay}"
                                 Minimum="1" Maximum="65535" Increment="1" FormatString="0" MinWidth="120" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="field-label"
                             Text="{Binding [Settings.Actions.Smtp.Security], Source={x:Static svc:Localizer.Instance}}" />
                  <ComboBox Grid.Column="1" Classes="field"
                            ItemsSource="{Binding SmtpSecurityOptions}"
                            SelectedItem="{Binding SmtpSecurity, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding Display}" />
                </Grid>
                <TextBox Text="{Binding SmtpFrom, Mode=TwoWay}"
                         PlaceholderText="{Binding [Settings.Actions.Smtp.From], Source={x:Static svc:Localizer.Instance}}" />
                <TextBox Text="{Binding SmtpUser, Mode=TwoWay}"
                         PlaceholderText="{Binding [Settings.Actions.Smtp.User], Source={x:Static svc:Localizer.Instance}}" />
                <TextBox Text="{Binding SmtpPassword, Mode=TwoWay}" PasswordChar="•"
                         PlaceholderText="{Binding [Settings.Actions.Smtp.Password], Source={x:Static svc:Localizer.Instance}}" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                  <Button Classes="outlined"
                          Content="{Binding [Settings.Actions.Smtp.Save], Source={x:Static svc:Localizer.Instance}}"
                          Command="{Binding SaveCredentialsCommand}" />
                  <Button Classes="outlined" IsVisible="{Binding IsWindows}"
                          Content="{Binding [Settings.Actions.Smtp.OpenCredMan], Source={x:Static svc:Localizer.Instance}}"
                          Command="{Binding OpenCredentialManagerCommand}" />
                </WrapPanel>
                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap" Text="{Binding CredentialStorageHint}" />
              </StackPanel>
              <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         TextWrapping="Wrap" IsVisible="{Binding IsMapi}"
                         Text="{Binding [Settings.Actions.Email.Mapi.Hint], Source={x:Static svc:Localizer.Instance}}" />
              <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         TextWrapping="Wrap" IsVisible="{Binding IsOutlook}"
                         Text="{Binding [Settings.Actions.Email.Outlook.Hint], Source={x:Static svc:Localizer.Instance}}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <Button Classes="outlined" HorizontalAlignment="Left"
                      Content="{Binding [Settings.Actions.Test], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding TestEmailCommand}" />
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSm}"
                         Text="{Binding EmailStatus}"
                         IsVisible="{Binding EmailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Program / script -->
            <StackPanel Spacing="14" IsVisible="{Binding IsDesktop}">
              <Border Background="{StaticResource BorderWeakBrush}" Height="1" />
              <CheckBox IsChecked="{Binding ProgramEnabled}" FontWeight="SemiBold"
                        Content="{Binding [Settings.Actions.Program], Source={x:Static svc:Localizer.Instance}}"
                        Foreground="{StaticResource TextPrimaryBrush}" />
              <StackPanel Spacing="8" IsEnabled="{Binding ProgramEnabled}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding ProgramPath, Mode=TwoWay}"
                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSm}"
                           PlaceholderText="{Binding [Settings.Actions.Program.Path], Source={x:Static svc:Localizer.Instance}}" />
                  <Button Grid.Column="1" Classes="outlined" Margin="8,0,0,0"
                          Content="{Binding [Settings.Actions.Program.Browse], Source={x:Static svc:Localizer.Instance}}"
                          Command="{Binding PickProgramCommand}" />
                </Grid>
                <TextBox Text="{Binding ProgramArguments, Mode=TwoWay}"
                         FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeSm}"
                         PlaceholderText="{Binding [Settings.Actions.Program.Args], Source={x:Static svc:Localizer.Instance}}" />
                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap"
                           Text="{Binding [Settings.Actions.Program.Hint], Source={x:Static svc:Localizer.Instance}}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <Button Classes="outlined" HorizontalAlignment="Left"
                        Content="{Binding [Settings.Actions.Test], Source={x:Static svc:Localizer.Instance}}"
                        Command="{Binding TestProgramCommand}" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSm}"
                           Text="{Binding ProgramStatus}"
                           IsVisible="{Binding ProgramStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        </Panel>
        </Panel>

        <!-- About -->
        <StackPanel IsVisible="{Binding IsAbout}" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="lucide section-icon" Data="{StaticResource IconAbout}" />
            <TextBlock Classes="section-title"
                       Text="{Binding [Settings.About], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>

          <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
            <Run Text="OpenIPC Viewer " />
            <Run Text="{Binding Version}" />
          </TextBlock>

          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Classes="outlined"
                    Content="{Binding [Settings.About.Repository], Source={x:Static svc:Localizer.Instance}}"
                    Command="{Binding OpenRepositoryCommand}" />
            <Button Classes="outlined"
                    Content="{Binding [Settings.Report.Button], Source={x:Static svc:Localizer.Instance}}"
                    Command="{Binding ReportIssueCommand}" />
            <Button Classes="outlined"
                    Content="{Binding [Settings.Report.OpenLogs], Source={x:Static svc:Localizer.Instance}}"
                    Command="{Binding OpenLogsDirectoryCommand}" />
          </WrapPanel>

          <!-- Updates: notify-only — the app never replaces itself (Phase 11.5). -->
          <StackPanel Spacing="8" IsVisible="{Binding UpdatesSupported}">
            <CheckBox IsChecked="{Binding CheckForUpdates}"
                      Content="{Binding [Settings.About.Updates.Auto], Source={x:Static svc:Localizer.Instance}}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8">
              <Button Classes="outlined"
                      Content="{Binding [Settings.About.Updates.Check], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding CheckForUpdatesNowCommand}" />
              <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </WrapPanel>
            <TextBlock Text="{Binding UpdateSourceText}"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       FontSize="{StaticResource FontSizeSm}" />
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
