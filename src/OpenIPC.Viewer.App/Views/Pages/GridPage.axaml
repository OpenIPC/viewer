<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenIPC.Viewer.App.ViewModels"
             xmlns:controls="using:OpenIPC.Viewer.App.Controls"
             xmlns:conv="using:OpenIPC.Viewer.App.Converters"
             xmlns:svc="using:OpenIPC.Viewer.App.Services"
             xmlns:input="using:Avalonia.Input"
             xmlns:b="using:OpenIPC.Viewer.App.Behaviors"
             x:Class="OpenIPC.Viewer.App.Views.Pages.GridPage"
             x:DataType="vm:GridPageViewModel">

  <UserControl.Styles>
    <!-- Narrow viewports: segment and "+ layout" labels collapse to icons. -->
    <Style Selector="Grid.compact TextBlock.wide-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" b:Adaptive.CompactBelow="700">

    <!-- Toolbar: view mode (live / stills), then page-level tools (health,
         fullscreen) behind a divider. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0"
                 Text="{Binding Title}"
                 FontSize="{StaticResource FontSizeXl}"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <!-- Live video vs stills (periodic snapshots — cheap on big walls). -->
        <Border Classes="segmented" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Classes="segment" GroupName="GridViewMode"
                         IsChecked="{Binding LiveMode, Mode=TwoWay}"
                         ToolTip.Tip="{Binding [Grid.Tooltip.Live], Source={x:Static svc:Localizer.Instance}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="lucide" Data="{StaticResource IconVideoCam}" Width="16" VerticalAlignment="Center" />
                <TextBlock Classes="wide-only" VerticalAlignment="Center" Text="{Binding [Grid.Mode.Live], Source={x:Static svc:Localizer.Instance}}" />
              </StackPanel>
            </RadioButton>
            <RadioButton Classes="segment" GroupName="GridViewMode"
                         IsChecked="{Binding StillsMode, Mode=TwoWay}"
                         ToolTip.Tip="{Binding [Grid.Tooltip.Stills], Source={x:Static svc:Localizer.Instance}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="lucide" Data="{StaticResource IconImage}" Width="14" Height="14" />
                <TextBlock Classes="wide-only" VerticalAlignment="Center" Text="{Binding [Grid.Mode.Stills], Source={x:Static svc:Localizer.Instance}}" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
        <ComboBox ItemsSource="{Binding StillsIntervalOptions}"
                  SelectedItem="{Binding StillsIntervalSeconds, Mode=TwoWay}"
                  IsVisible="{Binding StillsMode}"
                  MinWidth="64"
                  x:CompileBindings="False"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{Binding [Grid.Tooltip.StillsInterval], Source={x:Static svc:Localizer.Instance}}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StringFormat='{}{0}s'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Border Width="1" Height="20" Margin="4,0" VerticalAlignment="Center"
                Background="{StaticResource BorderMediumBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Command="{Binding OpenHealthCommand}"
                  Padding="10,6" CornerRadius="6"
                  Background="{StaticResource Bg2Brush}"
                  BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                  ToolTip.Tip="{Binding [Health.Tooltip], Source={x:Static svc:Localizer.Instance}}">
            <Path Classes="lucide" Data="{StaticResource IconActivity}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
          </Button>
          <!-- Fullscreen / kiosk: full-bleed grid for a guard station (Phase 20). -->
          <Button Click="OnFullscreenClick"
                  Padding="10,6" CornerRadius="6"
                  Background="{StaticResource Bg2Brush}"
                  BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                  ToolTip.Tip="{Binding [Grid.Tooltip.Fullscreen], Source={x:Static svc:Localizer.Instance}}">
            <Path Classes="lucide" Data="{StaticResource IconMaximize}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Layout tabs (Phase 19.1). Per-layout actions live in the active tab's
         "⋯" menu (also on right-click); the grid size is per layout, so its
         picker sits on this row too. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ItemsControl ItemsSource="{Binding Layouts}" x:CompileBindings="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Tapped="OnTabTapped"
                        PointerPressed="OnTabPointerPressed"
                        PointerMoved="OnTabPointerMoved"
                        AttachedToVisualTree="OnTabAttached"
                        input:DragDrop.AllowDrop="True"
                        Cursor="Hand"
                        MinHeight="32"
                        Padding="12,0" CornerRadius="6"
                        BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
                  <Border.Background>
                    <MultiBinding Converter="{x:Static conv:LayoutTabBrushConverter.Instance}">
                      <Binding />
                      <Binding Path="DataContext.ActiveLayout" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                    </MultiBinding>
                  </Border.Background>
                  <Border.ContextFlyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnTabMenuOpening">
                      <MenuItem Header="{Binding [Layouts.Tooltip.Cameras], Source={x:Static svc:Localizer.Instance}}"
                                Click="OnTabMenuCamerasClick">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconVideo}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{Binding [Common.Rename], Source={x:Static svc:Localizer.Instance}}"
                                Click="OnTabMenuRenameClick">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Tag="delete"
                                Header="{Binding [Common.Delete], Source={x:Static svc:Localizer.Instance}}"
                                Foreground="{StaticResource DangerBrush}"
                                Click="OnTabMenuDeleteClick">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Border.ContextFlyout>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Classes="chip-icon"
                            Margin="0,0,-6,0"
                            Click="OnTabMoreClick"
                            ToolTip.Tip="{Binding [Layouts.Tooltip.Menu], Source={x:Static svc:Localizer.Instance}}">
                      <Button.IsVisible>
                        <MultiBinding Converter="{x:Static conv:LayoutTabIsActiveConverter.Instance}">
                          <Binding />
                          <Binding Path="DataContext.ActiveLayout" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        </MultiBinding>
                      </Button.IsVisible>
                      <Path Classes="lucide" Data="{StaticResource IconEllipsis}"
                            Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"
                            Width="14" VerticalAlignment="Center" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Command="{Binding AddLayoutCommand}"
                  MinHeight="32" Padding="10,0" CornerRadius="6"
                  Background="Transparent"
                  BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                  ToolTip.Tip="{Binding [Layouts.Tooltip.Add], Source={x:Static svc:Localizer.Instance}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="lucide" Data="{StaticResource IconPlus}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
              <TextBlock Classes="wide-only" VerticalAlignment="Center"
                         Text="{Binding [Layouts.Add], Source={x:Static svc:Localizer.Instance}}"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <!-- Grid size of the active layout: one button showing the current shape,
           the full 1×1…5×5 choice in its menu. -->
      <Button Grid.Column="1"
              Margin="8,0,0,0" MinHeight="32" Padding="10,0" CornerRadius="6"
              Background="{StaticResource Bg2Brush}"
              BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
              ToolTip.Tip="{Binding [Grid.Tooltip.GridSize], Source={x:Static svc:Localizer.Instance}}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="lucide" Data="{Binding LayoutSize, Converter={x:Static conv:GridSizeIconConverter.Instance}}"
                Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
          <TextBlock Text="{Binding LayoutSizeLabel}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <Path Classes="lucide" Data="{StaticResource IconChevronDown}"
                Stroke="{StaticResource TextSecondaryBrush}" Width="10" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="1×1" Command="{Binding SetLayoutCommand}" CommandParameter="1">
              <MenuItem.Icon>
                <Path Classes="lucide" Data="{StaticResource IconGrid1}" Width="14" Height="14"
                      Stroke="{Binding LayoutSize, Converter={x:Static conv:GridSizeBrushConverter.Instance}, ConverterParameter=1}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="2×2" Command="{Binding SetLayoutCommand}" CommandParameter="2">
              <MenuItem.Icon>
                <Path Classes="lucide" Data="{StaticResource IconGrid2}" Width="14" Height="14"
                      Stroke="{Binding LayoutSize, Converter={x:Static conv:GridSizeBrushConverter.Instance}, ConverterParameter=2}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="3×3" Command="{Binding SetLayoutCommand}" CommandParameter="3">
              <MenuItem.Icon>
                <Path Classes="lucide" Data="{StaticResource IconGrid3}" Width="14" Height="14"
                      Stroke="{Binding LayoutSize, Converter={x:Static conv:GridSizeBrushConverter.Instance}, ConverterParameter=3}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="4×4" Command="{Binding SetLayoutCommand}" CommandParameter="4">
              <MenuItem.Icon>
                <Path Classes="lucide" Data="{StaticResource IconGrid4}" Width="14" Height="14"
                      Stroke="{Binding LayoutSize, Converter={x:Static conv:GridSizeBrushConverter.Instance}, ConverterParameter=4}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="5×5" Command="{Binding SetLayoutCommand}" CommandParameter="5">
              <MenuItem.Icon>
                <Path Classes="lucide" Data="{StaticResource IconGrid5}" Width="14" Height="14"
                      Stroke="{Binding LayoutSize, Converter={x:Static conv:GridSizeBrushConverter.Instance}, ConverterParameter=5}" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Grid -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}" x:CompileBindings="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="4"
                  Background="{StaticResource Bg0Brush}"
                  CornerRadius="6"
                  ClipToBounds="True"
                  input:DragDrop.AllowDrop="True"
                  AttachedToVisualTree="OnSlotAttached">
            <Grid>
              <!-- Empty placeholder -->
              <Border IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNull}}"
                      Background="{StaticResource Bg1Brush}">
                <TextBlock Text="{Binding [Grid.EmptySlot], Source={x:Static svc:Localizer.Instance}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="{StaticResource FontSizeSm}" />
              </Border>

              <!-- Tile -->
              <ContentControl Content="{Binding}"
                              IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="vm:CameraTileViewModel">
                    <Grid Cursor="Hand"
                          Background="Transparent"
                          Tapped="OnTileTapped"
                          PointerPressed="OnTilePointerPressed"
                          PointerMoved="OnTilePointerMoved">
                      <controls:RtspVideoView Session="{Binding Session}"
                                              IsVisible="{Binding !StillsMode}" />

                      <!-- Stills mode: periodic HTTP snapshot instead of live video. -->
                      <Image Source="{Binding StillFrame}"
                             Stretch="Uniform"
                             IsVisible="{Binding StillsMode}" />

                      <!-- AI detection boxes (Phase 15.5), above the video. -->
                      <controls:DetectionOverlay Detections="{Binding Detections}"
                                                 ShowBoxes="{Binding AnalyticsEnabled}"
                                                 SourceAspect="{Binding SourceAspect}"
                                                 IsHitTestVisible="False" />

                      <!-- Top-left: name -->
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                              Background="#90000000" CornerRadius="3" Padding="6,2">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Medium" />
                      </Border>

                      <!-- Bottom-center: object counter -->
                      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8"
                              Background="#90000000" CornerRadius="3" Padding="6,2"
                              IsVisible="{Binding HasDetections}">
                        <TextBlock Text="{Binding DetectionCounter}" Foreground="White" FontSize="11" FontWeight="Medium" />
                      </Border>

                      <!-- Top-right: state badge -->
                      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                              CornerRadius="3" Padding="6,2"
                              Background="{Binding Status, Converter={x:Static conv:CameraStatusColorConverter.Instance}}">
                        <TextBlock Text="{Binding StateLabel}" Foreground="White"
                                   FontFamily="{StaticResource FontMono}" FontSize="10" />
                      </Border>

                      <!-- Bottom-right: stats (codec • res • fps) -->
                      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                              Background="#80000000" CornerRadius="3" Padding="6,2"
                              IsVisible="{Binding HasStats}">
                        <TextBlock Text="{Binding StatsLabel}"
                                   FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="White" />
                      </Border>

                      <!-- Bottom-left: HD snapshot. The tile streams SD, but the
                           service grabs an HD source (Majestic HTTP / brief main). -->
                      <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                              Command="{Binding SnapshotCommand}"
                              IsVisible="{Binding !IsFailed}"
                              Background="#80000000" CornerRadius="14"
                              Width="28" Height="28" Padding="0"
                              ToolTip.Tip="{Binding [Tile.Snapshot], Source={x:Static svc:Localizer.Instance}}">
                        <Path Classes="lucide" Data="{StaticResource IconCamera}"
                              Stroke="White" Width="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      </Button>

                      <!-- Listen toggle (Phase 17): makes this tile the single
                           audio source. Shown when a native sink exists. -->
                      <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="44,8,8,8"
                              Command="{Binding ToggleListenCommand}"
                              IsVisible="{Binding AudioAvailable}"
                              Background="#80000000" CornerRadius="14"
                              Width="28" Height="28" Padding="0"
                              ToolTip.Tip="{Binding [CameraPage.Tooltip.Listen], Source={x:Static svc:Localizer.Instance}}">
                        <Panel>
                          <Path Classes="lucide" Data="{StaticResource IconVolume}"
                                Stroke="{StaticResource AccentBrush}" Width="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsVisible="{Binding IsListening}" />
                          <Path Classes="lucide" Data="{StaticResource IconVolumeMuted}"
                                Stroke="White" Width="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsVisible="{Binding !IsListening}" />
                        </Panel>
                      </Button>

                      <!-- Brief "captured" flash. -->
                      <Border IsVisible="{Binding SnapshotFlash}" Background="#50FFFFFF"
                              IsHitTestVisible="False" />

                      <!-- Connecting / reconnecting dim overlay with spinner. -->
                      <Border IsVisible="{Binding IsConnecting}" Background="#80000000">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                          <ProgressBar IsIndeterminate="True" Width="110" />
                          <TextBlock Text="{Binding ConnectingLabel}"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     FontSize="{StaticResource FontSizeSm}"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>

                      <!-- Interactive error cell — reason + Retry / Close. -->
                      <Border IsVisible="{Binding IsFailed}" Background="#A4000000">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" Margin="12" MaxWidth="320">
                          <Path Classes="lucide" Data="{StaticResource IconPlugOff}"
                                Stroke="{StaticResource DangerBrush}" Width="26" Height="26"
                                HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding [Stream.Disconnected], Source={x:Static svc:Localizer.Instance}}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="{StaticResource FontSizeBase}"
                                     FontWeight="Medium"
                                     HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding ErrorDetail}"
                                     Foreground="{StaticResource TextTertiaryBrush}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Center" />
                          <StackPanel Orientation="Horizontal" Spacing="8"
                                      HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="{Binding [Common.Retry], Source={x:Static svc:Localizer.Instance}}"
                                    Command="{Binding RetryCommand}"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    CornerRadius="6" Padding="13,6" FontSize="12" />
                            <Button Content="{Binding [Common.Close], Source={x:Static svc:Localizer.Instance}}"
                                    Command="{Binding CloseCommand}"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    CornerRadius="6" Padding="13,6" FontSize="12" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Pager: < 1 2 3 > — pages of the active layout (LayoutSize² per page). -->
    <Border Grid.Row="3"
            IsVisible="{Binding HasMultiplePages}"
            HorizontalAlignment="Center"
            Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Command="{Binding PrevPageCommand}"
                IsEnabled="{Binding CanPrevPage}"
                Padding="8,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
          <Path Classes="lucide" Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
        </Button>

        <ItemsControl ItemsSource="{Binding Pages}" x:CompileBindings="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}"
                      Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      MinWidth="32" Padding="8,6" CornerRadius="6"
                      HorizontalContentAlignment="Center"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
                <Button.Background>
                  <MultiBinding Converter="{x:Static conv:PageActiveBrushConverter.Instance}">
                    <Binding />
                    <Binding Path="DataContext.CurrentPageDisplay" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                  </MultiBinding>
                </Button.Background>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanNextPage}"
                Padding="8,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
          <Path Classes="lucide" Data="{StaticResource IconChevronRight}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
