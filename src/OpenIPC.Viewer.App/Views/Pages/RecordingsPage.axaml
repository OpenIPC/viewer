<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenIPC.Viewer.App.ViewModels"
             xmlns:svc="using:OpenIPC.Viewer.App.Services"
             xmlns:conv="using:OpenIPC.Viewer.App.Converters"
             xmlns:pages="using:OpenIPC.Viewer.App.Views.Pages"
             xmlns:b="using:OpenIPC.Viewer.App.Behaviors"
             x:Class="OpenIPC.Viewer.App.Views.Pages.RecordingsPage"
             x:DataType="vm:RecordingsPageViewModel">

  <UserControl.Styles>
    <!-- Narrow viewport: the activity calendar drops from the left column to a
         band above the list so the list keeps the full width instead of being
         crushed into ~80px next to a fixed 240px calendar. Size also drops. -->
    <Style Selector="DockPanel.compact &gt; pages|ArchiveCalendarView">
      <Setter Property="(DockPanel.Dock)" Value="Top" />
    </Style>
    <Style Selector="DockPanel.compact TextBlock.wide-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Border.rec-row">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.rec-row:pointerover">
      <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Header: title, then the Recordings | Snapshots switch with the filtered
         recordings total on the right. -->
    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
      <TextBlock Text="{Binding Title}"
                 FontSize="{StaticResource FontSizeXl}"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}" />
      <Grid ColumnDefinitions="Auto,*">
        <Border Classes="segmented" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Classes="segment" GroupName="MediaTab"
                         IsChecked="{Binding IsRecordingsTabActive, Mode=TwoWay}"
                         Content="{Binding [Nav.Recordings], Source={x:Static svc:Localizer.Instance}}" />
            <RadioButton Classes="segment" GroupName="MediaTab"
                         IsChecked="{Binding IsSnapshotsTabActive, Mode=TwoWay}"
                         Content="{Binding [Snapshots.Title], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding Summary}"
                   IsVisible="{Binding ShowRecordings}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontFamily="{StaticResource FontMono}"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextSecondaryBrush}" />
      </Grid>
    </StackPanel>

    <!-- Snapshots tab -->
    <ContentControl Grid.Row="1" IsVisible="{Binding ShowSnapshots}">
      <pages:SnapshotBrowserView DataContext="{Binding Snapshots}" />
    </ContentControl>

    <!-- Recordings tab: calendar + filters + list. DockPanel docks the calendar
         Left on a wide viewport and Top when narrow (see .compact above). -->
    <DockPanel Grid.Row="1" IsVisible="{Binding ShowRecordings}"
               b:Adaptive.CompactBelow="620" LastChildFill="True">

      <!-- Activity calendar. Default Dock is Left; trailing margin works for
           both orientations. -->
      <pages:ArchiveCalendarView DataContext="{Binding Calendar}"
                                 Margin="0,0,16,16"
                                 VerticalAlignment="Top" />

      <Grid RowDefinitions="Auto,*,Auto">

        <!-- Filters: camera, period, motion. Same vocabulary as Snapshots. -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"
                   Margin="0,0,0,12">
          <ComboBox ItemsSource="{Binding CameraOptions}"
                    SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                    MinWidth="150" VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordingCameraOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <RadioButton Classes="chip" GroupName="RecPeriod" VerticalAlignment="Center"
                       IsChecked="{Binding IsPeriodAll, Mode=TwoWay}"
                       Content="{Binding [Snapshots.PresetAll], Source={x:Static svc:Localizer.Instance}}" />
          <RadioButton Classes="chip" GroupName="RecPeriod" VerticalAlignment="Center"
                       IsChecked="{Binding IsPeriodToday, Mode=TwoWay}"
                       Content="{Binding [Snapshots.PresetToday], Source={x:Static svc:Localizer.Instance}}" />
          <RadioButton Classes="chip" GroupName="RecPeriod" VerticalAlignment="Center"
                       IsChecked="{Binding IsPeriod7, Mode=TwoWay}"
                       Content="{Binding [Snapshots.Preset7], Source={x:Static svc:Localizer.Instance}}" />
          <RadioButton Classes="chip" GroupName="RecPeriod" VerticalAlignment="Center"
                       IsChecked="{Binding IsPeriod30, Mode=TwoWay}"
                       Content="{Binding [Snapshots.Preset30], Source={x:Static svc:Localizer.Instance}}" />
          <ToggleButton Classes="chip" VerticalAlignment="Center"
                        IsChecked="{Binding MotionOnly, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding [Recordings.MotionOnly], Source={x:Static svc:Localizer.Instance}}" />
            </StackPanel>
          </ToggleButton>
        </WrapPanel>

        <!-- Empty / no-match states -->
        <TextBlock Grid.Row="1" IsVisible="{Binding IsEmpty}"
                   Text="{Binding [Recordings.Empty], Source={x:Static svc:Localizer.Instance}}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" IsVisible="{Binding HasNoMatches}"
                   Text="{Binding [Recordings.NoMatches], Source={x:Static svc:Localizer.Instance}}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- List: day headers interleaved with dense recording rows. -->
        <ScrollViewer Grid.Row="1" x:Name="ListScroll" IsVisible="{Binding HasRows}">
          <Border Background="{StaticResource Bg2Brush}"
                  BorderBrush="{StaticResource BorderWeakBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="4,0,4,4" VerticalAlignment="Top">
            <ItemsControl ItemsSource="{Binding PageItems}" Grid.IsSharedSizeScope="True">
              <ItemsControl.DataTemplates>

                <DataTemplate DataType="vm:RecordingDayHeader">
                  <Grid ColumnDefinitions="*,Auto" Margin="8,12,8,4">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Totals}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:RecordingRowViewModel">
                  <Border Classes="rec-row" CornerRadius="8" Padding="8,5"
                          Cursor="Hand" Tapped="OnRowTapped"
                          ToolTip.Tip="{Binding FileName}">
                    <Border.ContextFlyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnRowMenuOpening">
                        <MenuItem Tag="folder"
                                  Header="{Binding [Recordings.ShowInFolder], Source={x:Static svc:Localizer.Instance}}"
                                  Click="OnShowInFolderClick">
                          <MenuItem.Icon>
                            <Path Classes="lucide" Data="{StaticResource IconFolder}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding [Recordings.CopyFile], Source={x:Static svc:Localizer.Instance}}"
                                  Click="OnCopyFileClick">
                          <MenuItem.Icon>
                            <Path Classes="lucide" Data="{StaticResource IconPaste}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{Binding [Common.Delete], Source={x:Static svc:Localizer.Instance}}"
                                  Foreground="{StaticResource DangerBrush}"
                                  Click="OnDeleteClick">
                          <MenuItem.Icon>
                            <Path Classes="lucide" Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}" Width="14" Height="14" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </Border.ContextFlyout>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Range" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Duration" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Button Grid.Column="0" Classes="play" Margin="0,0,12,0"
                              Command="{Binding $parent[ItemsControl].((vm:RecordingsPageViewModel)DataContext).PlayCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding [Recordings.Play], Source={x:Static svc:Localizer.Instance}}">
                        <Path Classes="lucide" Data="{StaticResource IconPlay}"
                              Stroke="White" Fill="White" Width="10" Height="10" Margin="2,0,0,0" />
                      </Button>

                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CameraName}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Classes="badge" Background="#33f59e0b" IsVisible="{Binding HasMotion}">
                          <TextBlock Text="{Binding [Recordings.Motion], Source={x:Static svc:Localizer.Instance}}"
                                     FontSize="11" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <Border Classes="badge" Background="#33ef4444" IsVisible="{Binding IsLive}">
                          <TextBlock Text="{Binding [Recordings.InProgress], Source={x:Static svc:Localizer.Instance}}"
                                     FontSize="11" Foreground="{StaticResource DangerBrush}" />
                        </Border>
                      </StackPanel>

                      <TextBlock Grid.Column="2" Text="{Binding TimeRange}"
                                 Margin="16,0,0,0" VerticalAlignment="Center"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="{StaticResource FontSizeSm}"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                 Margin="16,0,0,0" VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="{StaticResource FontSizeSm}"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="4" Classes="wide-only" Text="{Binding SizeLabel}"
                                 Margin="16,0,0,0" VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="{StaticResource FontSizeSm}"
                                 Foreground="{StaticResource TextTertiaryBrush}" />

                      <Button Grid.Column="5" Classes="row-icon" Margin="8,0,0,0"
                              Click="OnRowMoreClick"
                              ToolTip.Tip="{Binding [Recordings.Tooltip.More], Source={x:Static svc:Localizer.Instance}}">
                        <Path Classes="lucide" Data="{StaticResource IconEllipsis}"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                              Width="16" VerticalAlignment="Center" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>

              </ItemsControl.DataTemplates>
            </ItemsControl>
          </Border>
        </ScrollViewer>

        <!-- Pager: < 1 2 3 > -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Center" Margin="0,12,0,0"
                    IsVisible="{Binding HasMultiplePages}">
          <Button Command="{Binding PrevPageCommand}"
                  IsEnabled="{Binding CanPrevPage}"
                  Padding="8,6" CornerRadius="6"
                  Background="{StaticResource Bg2Brush}"
                  BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
            <Path Classes="lucide" Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
          </Button>
          <ItemsControl ItemsSource="{Binding Pages}" x:CompileBindings="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding}"
                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        MinWidth="32" Padding="8,6" CornerRadius="6"
                        HorizontalContentAlignment="Center"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
                  <Button.Background>
                    <MultiBinding Converter="{x:Static conv:PageActiveBrushConverter.Instance}">
                      <Binding />
                      <Binding Path="DataContext.CurrentPageDisplay" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                    </MultiBinding>
                  </Button.Background>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanNextPage}"
                  Padding="8,6" CornerRadius="6"
                  Background="{StaticResource Bg2Brush}"
                  BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
            <Path Classes="lucide" Data="{StaticResource IconChevronRight}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
          </Button>
        </StackPanel>

        <!-- Error overlay -->
        <StackPanel Grid.Row="1" IsVisible="{Binding HasLoadError}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12">
          <TextBlock Text="{Binding LoadError}"
                     FontSize="{StaticResource FontSizeLg}"
                     Foreground="{StaticResource DangerBrush}"
                     HorizontalAlignment="Center" />
          <Button Content="{Binding [Common.Retry], Source={x:Static svc:Localizer.Instance}}"
                  Command="{Binding ReloadCommand}"
                  Padding="14,8"
                  Background="Transparent"
                  BorderBrush="{StaticResource BorderMediumBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Loading overlay (rendered last → on top). -->
        <StackPanel Grid.Row="1" IsVisible="{Binding IsLoading}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="160" />
          <TextBlock Text="{Binding [Common.Loading], Source={x:Static svc:Localizer.Instance}}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>

      </Grid>
    </DockPanel>

  </Grid>

</UserControl>
