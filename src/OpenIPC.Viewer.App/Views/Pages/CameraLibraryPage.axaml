<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenIPC.Viewer.App.ViewModels"
             xmlns:svc="using:OpenIPC.Viewer.App.Services"
             xmlns:conv="using:OpenIPC.Viewer.App.Converters"
             xmlns:b="using:OpenIPC.Viewer.App.Behaviors"
             x:Class="OpenIPC.Viewer.App.Views.Pages.CameraLibraryPage"
             x:DataType="vm:CameraLibraryPageViewModel">

  <UserControl.Styles>
    <!-- Wide: host and layouts get their own aligned columns. Compact (<700px):
         those columns drop and the host moves under the camera name. The header
         has its own, wider breakpoint (it needs ~880px on one line). -->
    <Style Selector="Grid.compact :is(Control).wide-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(Control).compact-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.compact :is(Control).compact-only">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Header. Wide: title, then [search · group · tag · refresh] on the left
         and the add actions on the right. Compact: the add actions join the
         title row (icon-only "find"), search takes a full-width row and the
         group filter stretches beside the tag / refresh buttons.
         Everything that moves is placed by styles only — a local Grid.Row /
         Column / Margin would outrank the compact setters. -->
    <Style Selector="StackPanel.header-actions">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Margin" Value="16,12,0,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.compact StackPanel.header-actions">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.filters">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Grid.compact Grid.filters">
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid.filters > TextBox">
      <Setter Property="Width" Value="240" />
    </Style>
    <Style Selector="Grid.compact Grid.filters > TextBox">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Grid.ColumnSpan" Value="4" />
    </Style>
    <Style Selector="Grid.filters > ComboBox">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Grid.compact Grid.filters > ComboBox">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Grid.filters > Button">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Grid.compact Grid.filters > Button">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Margin" Value="8,8,0,0" />
    </Style>

    <Style Selector="Border.camera-row">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.camera-row:pointerover">
      <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    </Style>

    <Style Selector="Button.header">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" b:Adaptive.CompactBelow="700">

    <!-- Header: title, filters and add actions (see the header styles above
         for the wide / compact placement). -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,12"
          b:Adaptive.CompactBelow="900">
      <TextBlock Text="{Binding [Library.Title], Source={x:Static svc:Localizer.Instance}}"
                 FontSize="{StaticResource FontSizeXl}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{StaticResource TextPrimaryBrush}" />

      <Grid Grid.Row="1" Classes="filters" Margin="0,12,0,0"
            ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                 Classes="clearButton"
                 VerticalContentAlignment="Center"
                 PlaceholderText="{Binding [Library.SearchPlaceholder], Source={x:Static svc:Localizer.Instance}}">
          <TextBox.InnerLeftContent>
            <Path Classes="lucide" Data="{StaticResource IconSearch}"
                  Stroke="{StaticResource TextTertiaryBrush}"
                  Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <ComboBox ItemsSource="{Binding AvailableGroups}"
                  SelectedItem="{Binding SelectedGroupFilter, Mode=TwoWay}"
                  MinWidth="150"
                  VerticalAlignment="Center"
                  PlaceholderText="{Binding [Library.AllGroups], Source={x:Static svc:Localizer.Instance}}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name, FallbackValue='', TargetNullValue=''}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Classes="header"
                Command="{Binding ManageGroupsCommand}"
                ToolTip.Tip="{Binding [Library.Tooltip.ManageGroups], Source={x:Static svc:Localizer.Instance}}">
          <Path Classes="lucide" Data="{StaticResource IconTag}"
                Stroke="{StaticResource TextPrimaryBrush}" Width="16" Height="16" />
        </Button>
        <Button Grid.Column="3" Classes="header"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="{Binding [Library.Tooltip.Refresh], Source={x:Static svc:Localizer.Instance}}">
          <Path Classes="lucide" Data="{StaticResource IconRefresh}"
                Stroke="{StaticResource TextPrimaryBrush}" Width="16" Height="16" />
        </Button>
      </Grid>

      <StackPanel Grid.Column="1" Classes="header-actions" Orientation="Horizontal" Spacing="8">
        <Button Classes="header" Command="{Binding DiscoverCameraCommand}"
                ToolTip.Tip="{Binding [Library.FindOnNetwork], Source={x:Static svc:Localizer.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="lucide" Data="{StaticResource IconRadar}"
                  Stroke="{StaticResource TextPrimaryBrush}"
                  Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Classes="wide-only" VerticalAlignment="Center"
                       Text="{Binding [Library.FindOnNetwork], Source={x:Static svc:Localizer.Instance}}" />
          </StackPanel>
        </Button>
        <Button Classes="header"
                Command="{Binding ScanQrCommand}"
                ToolTip.Tip="{Binding [Library.ScanQr], Source={x:Static svc:Localizer.Instance}}">
          <Path Classes="lucide" Data="{StaticResource IconQr}"
                Stroke="{StaticResource TextPrimaryBrush}" Width="16" Height="16" />
        </Button>
        <Button Command="{Binding AddCameraCommand}"
                Padding="12,7"
                Background="{StaticResource AccentBrush}"
                Foreground="White"
                CornerRadius="8"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Center">
          <Panel>
            <TextBlock Classes="wide-only" VerticalAlignment="Center"
                       Text="{Binding [Common.AddCamera], Source={x:Static svc:Localizer.Instance}}" />
            <StackPanel Classes="compact-only" Orientation="Horizontal" Spacing="6">
              <Path Classes="lucide" Data="{StaticResource IconPlus}"
                    Stroke="White" StrokeThickness="2.2" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center"
                         Text="{Binding [Library.AddShort], Source={x:Static svc:Localizer.Instance}}" />
            </StackPanel>
          </Panel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Status filter chips with live counters. -->
    <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"
               Margin="0,0,0,12" IsVisible="{Binding HasCameras}">
      <RadioButton Classes="chip" GroupName="LibraryStatus" IsChecked="{Binding IsFilterAll, Mode=TwoWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding [Library.Filter.All], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource TextTertiaryBrush}" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="chip" GroupName="LibraryStatus" IsChecked="{Binding IsFilterOnline, Mode=TwoWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="7" Height="7" Fill="#22c55e" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Library.Filter.Online], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Text="{Binding OnlineCount}" Foreground="{StaticResource TextTertiaryBrush}" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="chip" GroupName="LibraryStatus" IsChecked="{Binding IsFilterOffline, Mode=TwoWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="7" Height="7" Fill="#5e6878" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Library.Filter.Offline], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Text="{Binding OfflineCount}" Foreground="{StaticResource TextTertiaryBrush}" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="chip" GroupName="LibraryStatus" IsChecked="{Binding IsFilterAttention, Mode=TwoWay}"
                   IsVisible="{Binding HasAttention}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="7" Height="7" Fill="#f97316" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Library.Filter.Attention], Source={x:Static svc:Localizer.Instance}}" />
          <TextBlock Text="{Binding AttentionCount}" Foreground="{StaticResource TextTertiaryBrush}" />
        </StackPanel>
      </RadioButton>
    </WrapPanel>

    <!-- Empty state -->
    <StackPanel Grid.Row="2"
                IsVisible="{Binding IsEmpty}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12">
      <TextBlock Text="{Binding [Library.EmptyTitle], Source={x:Static svc:Localizer.Instance}}"
                 FontSize="{StaticResource FontSizeLg}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 HorizontalAlignment="Center" />
      <Button Content="{Binding [Common.AddCamera], Source={x:Static svc:Localizer.Instance}}"
              Command="{Binding AddCameraCommand}"
              Padding="14,8"
              Background="{StaticResource AccentBrush}"
              Foreground="White"
              CornerRadius="8"
              HorizontalAlignment="Center" />
    </StackPanel>

    <!-- List: one dense row per camera. Empty/Loading panels share row 2 and
         render in document order; the loader sits last so it floats on top
         during refresh of a populated list. -->
    <ScrollViewer Grid.Row="2" x:Name="ListScroll" IsVisible="{Binding HasCameras}">
      <Border Background="{StaticResource Bg2Brush}"
              BorderBrush="{StaticResource BorderWeakBrush}" BorderThickness="1"
              CornerRadius="10" Padding="4" VerticalAlignment="Top">
        <Panel>
          <TextBlock IsVisible="{Binding HasNoMatches}"
                     Text="{Binding [Library.NoMatches], Source={x:Static svc:Localizer.Instance}}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" Margin="0,24" />
          <ItemsControl ItemsSource="{Binding PageRows}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CameraRowViewModel">
                <Border Classes="camera-row"
                        CornerRadius="8"
                        Padding="8,6"
                        Cursor="Hand"
                        Tapped="OnCameraCardTapped">
                  <Border.ContextFlyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnRowMenuOpening">
                      <MenuItem Header="{Binding [Library.RowEdit], Source={x:Static svc:Localizer.Instance}}"
                                Click="OnRowEditClick">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{Binding [Library.RowDevice], Source={x:Static svc:Localizer.Instance}}"
                                Click="OnRowDeviceClick">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconCpu}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <!-- Risky tool (Settings → Advanced): shown only when the
                           shared "risky device tools" toggle is on. -->
                      <MenuItem Tag="files"
                                Header="{Binding [Library.RowFiles], Source={x:Static svc:Localizer.Instance}}"
                                Click="OnRowFilesClick">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconFolder}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <!-- Filled per open with one checkable item per layout. -->
                      <MenuItem Tag="layouts"
                                Header="{Binding [Library.RowLayouts], Source={x:Static svc:Localizer.Instance}}">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconGrid2}" Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="{Binding [Library.RowDelete], Source={x:Static svc:Localizer.Instance}}"
                                Foreground="{StaticResource DangerBrush}"
                                Click="OnRowDeleteClick">
                        <MenuItem.Icon>
                          <Path Classes="lucide" Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Border.ContextFlyout>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Host" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Layouts" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Preview slot (real stills come later) with the status
                         dot on its corner. -->
                    <Panel Grid.Column="0" Width="56" Height="36" Margin="0,0,12,0"
                           ToolTip.Tip="{Binding StatusText}">
                      <Border Background="{StaticResource Bg0Brush}" CornerRadius="6">
                        <Path Classes="lucide" Data="{StaticResource IconVideoCam}"
                              Stroke="{StaticResource TextTertiaryBrush}"
                              Width="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Ellipse Width="11" Height="11"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-3,-3"
                               Stroke="{StaticResource Bg2Brush}" StrokeThickness="2"
                               Fill="{Binding Status, Converter={x:Static conv:LibraryStatusColorConverter.Instance}}" />
                    </Panel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="{StaticResource FontSizeMd}"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding GroupName}"
                                   IsVisible="{Binding HasGroup}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Classes="compact-only"
                                   Text="{Binding HostAndPort}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Classes="wide-only"
                               Text="{Binding HostAndPort}"
                               Margin="16,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Classes="wide-only"
                               Text="{Binding LayoutsLabel}"
                               ToolTip.Tip="{Binding [Library.RowLayouts], Source={x:Static svc:Localizer.Instance}}"
                               Margin="16,0,0,0" MaxWidth="200" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" Margin="12,0,0,0">
                      <Button Classes="row-icon"
                              Command="{Binding $parent[ItemsControl].((vm:CameraLibraryPageViewModel)DataContext).OpenWebInterfaceCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding [Library.RowOpenWeb], Source={x:Static svc:Localizer.Instance}}">
                        <Path Classes="lucide" Data="{StaticResource IconGlobe}"
                              Stroke="{StaticResource TextSecondaryBrush}" Width="16" Height="16" />
                      </Button>
                      <Button Classes="row-icon"
                              Command="{Binding $parent[ItemsControl].((vm:CameraLibraryPageViewModel)DataContext).OpenSshTerminalCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding [Library.RowSsh], Source={x:Static svc:Localizer.Instance}}">
                        <Path Classes="lucide" Data="{StaticResource IconTerminalBox}"
                              Stroke="{StaticResource TextSecondaryBrush}" Width="16" VerticalAlignment="Center" />
                      </Button>
                      <Button Classes="row-icon"
                              Click="OnRowMoreClick"
                              ToolTip.Tip="{Binding [Library.Tooltip.More], Source={x:Static svc:Localizer.Instance}}">
                        <Path Classes="lucide" Data="{StaticResource IconEllipsis}"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                              Width="16" VerticalAlignment="Center" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </Border>
    </ScrollViewer>

    <!-- Pager: < 1 2 3 > — PageSize rows per page of the filtered list. -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4"
                HorizontalAlignment="Center" Margin="0,12,0,0"
                IsVisible="{Binding HasMultiplePages}">
      <Button Command="{Binding PrevPageCommand}"
              IsEnabled="{Binding CanPrevPage}"
              Padding="8,6" CornerRadius="6"
              Background="{StaticResource Bg2Brush}"
              BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
        <Path Classes="lucide" Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
      </Button>
      <ItemsControl ItemsSource="{Binding Pages}" x:CompileBindings="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}"
                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    MinWidth="32" Padding="8,6" CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
              <Button.Background>
                <MultiBinding Converter="{x:Static conv:PageActiveBrushConverter.Instance}">
                  <Binding />
                  <Binding Path="DataContext.CurrentPageDisplay" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                </MultiBinding>
              </Button.Background>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Command="{Binding NextPageCommand}"
              IsEnabled="{Binding CanNextPage}"
              Padding="8,6" CornerRadius="6"
              Background="{StaticResource Bg2Brush}"
              BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
        <Path Classes="lucide" Data="{StaticResource IconChevronRight}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
      </Button>
    </StackPanel>

    <!-- Loading overlay (rendered last → on top). -->
    <StackPanel Grid.Row="2"
                IsVisible="{Binding IsLoading}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12">
      <ProgressBar IsIndeterminate="True" Width="160" />
      <TextBlock Text="{Binding [Common.Loading], Source={x:Static svc:Localizer.Instance}}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 HorizontalAlignment="Center" />
    </StackPanel>

  </Grid>
</UserControl>
