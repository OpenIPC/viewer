<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1014</NoWarn>
  </PropertyGroup>

  <!-- Versioning. The real version comes from the nearest git release tag (see
       Directory.Build.targets → SetVersionFromGit). This is only the fallback
       for builds without git / tags, so a tarball build never shows 1.0.0.0. -->
  <PropertyGroup>
    <Version>0.1.9</Version>
    <!-- We set a clean InformationalVersion ourselves; suppress the SDK's
         "+<commit-sha>" suffix so About shows just the tag. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Where the app looks for new versions (Infrastructure/Updates/UpdateFeedFactory):
       github:<owner>/<repo>, an https:// URL of a latest.json manifest, or none to turn
       update checks off (store builds such as F-Droid update through the store). -->
  <PropertyGroup>
    <UpdateFeed Condition="'$(UpdateFeed)' == ''">github:OpenIPC/viewer</UpdateFeed>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OpenIpc.UpdateFeed" Value="$(UpdateFeed)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
